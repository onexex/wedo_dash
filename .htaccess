# 0. 🔒 No folder listings ("Index of /wedo/tools"): a folder without an index
#    page answers 403 instead of listing its files.
Options -Indexes

RewriteEngine On

# 1. ✅ Bypass para sa file authentication (Dapat laging nasa pinakataas)
RewriteCond %{REQUEST_URI} ^/fileauth\.txt$ [NC]
RewriteRule ^ - [L]

# 1b. 🔒 Security hardening — block source-disclosure & VCS files
#     Backups / source dumps (e.g. login.php.bak, *.secbak, *.sql, *.log)
RewriteRule \.(bak|secbak|orig|save|swp|swo|sql|log)$ - [F,L]
#     Version-control metadata (/.git/…), PHP ini overrides, credential override
RewriteRule (^|/)\.git(/|$) - [F,L]
RewriteRule (^|/)\.user\.ini$ - [F,L]
RewriteRule (^|/)config\.local\.php$ - [F,L]
#     Developer-only folders (scripts, tests, Composer packages) — older deploys
#     copied tools/ to the servers, so it is blocked here as well as left out of the zip
RewriteRule (^|/)(tools|tests|vendor|\.phpunit\.cache)(/|$) - [F,L]
#     Database migration notes and Composer / PHPUnit config
RewriteRule (^|/)(composer\.(json|lock)|phpunit\.xml\.dist)$ - [F,L]

# 2. ✅ TAMA NA REDIRECT: I-force ang HTTP papuntang HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2b. Public job application: applicants only ever see ".../apply". A browser
#     opening /apply.php (old links) is sent there; the form's own endpoint
#     (query/apply-action.php) is a different name and is never redirected.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s[^?\s]*/apply\.php[\s?]
RewriteCond %{REQUEST_URI} ^(.*/)apply\.php$
RewriteRule ^ %1apply [R=301,L]

# 3. ✅ Extension removal / Clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f 
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-d 
RewriteCond %{REQUEST_FILENAME}.html -f 
RewriteRule ^(.*)$ $1.html [L]

# 4. ✅ Iba pang configurations (Error pages at server modules)
ErrorDocument 404 /404.php

<IfModule mod_suphp.c> 
    suPHP_ConfigPath /public_html/dashboard.wedoinc.ph
    <Files php.ini>
        order allow,deny
        deny from all
    </Files>
</IfModule>

<IfModule mod_speling.c>
    CheckCaseOnly on
    CheckSpelling on
</IfModule>