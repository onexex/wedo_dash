# PHP / server runtime logs (must never be committed — can grow to hundreds of MB)
error_log
**/error_log
*.log

# local/prod DB credential override (never commit)
config.local.php
*.bak
.claude/

# Login Theme banner uploads (Maintenance > Login Theme) — server data, not code
assets/images/login-themes/

# Pictures + documents sent in Messages (includes/msg-files.php) — server data, not code
uploads/

# Employee signatures for ID cards (Management > ID Card Generator) — server data, not code
assets/images/id-signatures/

# Dev-only test tooling (composer install; never deployed)
vendor/
.phpunit.cache/
